{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "bin/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ]
    },
    "clean": {
      "cache": false
    },
    "@initlabs/vibekit-website#typecheck": {
      "dependsOn": [
        "^build",
        "build"
      ]
    }
  }
}
