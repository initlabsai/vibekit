{
  "name": "vibekit",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "cli": "bun run --cwd apps/cli dev",
    "tui": "bun run --cwd apps/tui dev",
    "web": "bun run --cwd apps/web dev",
    "mcp": "bun run --cwd apps/mcp dev",
    "verify:packed": "bun scripts/verify-packed.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "^5.9.3"
  }
}
