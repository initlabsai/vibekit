{
  "name": "@initlabs/vibekit-mcp",
  "version": "0.1.0",
  "description": "createVibekitMcp(): the VibeKit MCP server as a library — stateless (2026-07-28 spec), composed from @initlabs tool packages and plugins.",
  "license": "Apache-2.0",
  "author": "Init Labs LLC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stdio": {
      "types": "./dist/stdio.d.ts",
      "import": "./dist/stdio.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "peerDependencies": {
    "@initlabs/vibekit-core": "^0.1.0",
    "algosdk": ">=3.7.0 <4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@initlabs/vibekit-core": "workspace:*",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.4.0",
    "algosdk": "3.7.0",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/initlabsai/vibekit.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/initlabsai/vibekit#readme",
  "publishConfig": {
    "access": "public"
  }
}
