{
  "name": "@initlabs/mcp",
  "version": "0.1.0",
  "description": "createVibekitMcp(): the VibeKit MCP server as a library — stateless (2026-07-28 spec), composed from @initlabs tool packages and plugins.",
  "license": "Apache-2.0",
  "author": "Init Labs LLC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stdio": {
      "types": "./dist/stdio.d.ts",
      "import": "./dist/stdio.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "peerDependencies": {
    "@initlabs/core": "^0.1.0",
    "algosdk": ">=3.7.0-beta.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@initlabs/core": "workspace:*",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.2.0",
    "algosdk": "3.7.0-beta.1",
    "zod": "^4.4.3"
  }
}
