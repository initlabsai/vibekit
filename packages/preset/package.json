{
  "name": "@initlabs/vibekit-preset",
  "version": "1.0.0-alpha.0",
  "description": "VibeKit batteries-included host wiring: the full tool surface, default plugins, keystore signing tools, and the NETWORK env convention.",
  "license": "MIT",
  "author": "Init Labs LLC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@initlabs/vibekit-plugin-alpha-arcade": "workspace:*",
    "@initlabs/vibekit-plugin-nfd": "workspace:*",
    "@initlabs/vibekit-plugin-pera": "workspace:*",
    "@initlabs/vibekit-plugin-vestige": "workspace:*",
    "@initlabs/vibekit-signer-keystore": "workspace:*",
    "@initlabs/vibekit-tools": "workspace:*"
  },
  "peerDependencies": {
    "@initlabs/vibekit-core": "^1.0.0-alpha.0",
    "algosdk": ">=3.7.0 <4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@initlabs/vibekit-core": "workspace:*",
    "@types/bun": "^1.4.0",
    "algosdk": "3.7.0",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/initlabsai/vibekit.git",
    "directory": "packages/preset"
  },
  "homepage": "https://github.com/initlabsai/vibekit#readme",
  "publishConfig": {
    "access": "public"
  }
}
