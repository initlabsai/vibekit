{
  "name": "@initlabs/vibekit-explorer",
  "version": "1.0.0-alpha.2",
  "private": true,
  "description": "Browser-safe Explorer protocol, workspace state, fixtures, and semantic view models; the ./live subpath adds the signerless compose-only live host.",
  "license": "MIT",
  "author": "Init Labs LLC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./live": {
      "types": "./dist/live/index.d.ts",
      "import": "./dist/live/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p examples/tsconfig.json",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "9.2.0",
    "@alpha-arcade/sdk": "0.4.11",
    "@initlabs/vibekit": "workspace:*",
    "algosdk": "3.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
