{
  "name": "@initlabs/vibekit-agent",
  "version": "1.0.0-alpha.0",
  "description": "The VibeKit orchestrator: LLM + tool loop + streaming over ToolDefinition[], with BYOM provider config. One brain for the TUI, the hosted API, and anything else.",
  "license": "MIT",
  "author": "Init Labs LLC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.40",
    "@ai-sdk/openai": "^4.0.45",
    "@ai-sdk/openai-compatible": "^3.0.34",
    "ai": "^7.0.74"
  },
  "peerDependencies": {
    "@initlabs/vibekit-core": "^1.0.0-alpha.0",
    "algosdk": ">=3.7.0 <4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@initlabs/vibekit-core": "workspace:*",
    "@types/bun": "^1.4.0",
    "algosdk": "3.7.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/initlabsai/vibekit.git",
    "directory": "packages/agent"
  },
  "homepage": "https://github.com/initlabsai/vibekit#readme",
  "publishConfig": {
    "access": "public"
  }
