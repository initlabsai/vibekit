  "description": "VibeKit domain tools for Algorand: accounts, assets, contracts, network, and transactions.",
  "license": "Apache-2.0",
  "author": "Init Labs LLC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
