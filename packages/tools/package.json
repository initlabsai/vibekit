  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@initlabs/vibekit-core": "^0.1.0",
    "algosdk": ">=3.7.0 <4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@initlabs/vibekit-core": "workspace:*",
    "@types/bun": "^1.2.0",
    "algosdk": "3.7.0",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/initlabsai/vibekit.git",
    "directory": "packages/tools"
  },
  "homepage": "https://github.com/initlabsai/vibekit#readme",
  "publishConfig": {
    "access": "public"
  }
