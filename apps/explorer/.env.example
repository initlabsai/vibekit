# LLM Configuration (any OpenAI-compatible API)
LLM_BASE_URL=               # e.g., https://api.together.xyz/v1, http://localhost:11434/v1
LLM_API_KEY=                 # API key for the LLM provider
LLM_MODEL=                   # e.g., Qwen/Qwen3-235B-A22B, gpt-4o, etc.

# Algorand Network (mainnet | testnet | localnet)
ALGORAND_NETWORK=mainnet

# Optional - override network preset
ALGORAND_INDEXER_URL=
ALGORAND_INDEXER_TOKEN=
