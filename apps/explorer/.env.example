# LLM — Together AI (or any OpenAI-compatible API)
LLM_BASE_URL=https://api.together.xyz/v1
LLM_API_KEY=              # Together AI API key
LLM_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000   # optional, default 60s
RATE_LIMIT_MAX_REQUESTS=10   # optional, default 10

# Algorand Network (mainnet | testnet | localnet)
ALGORAND_NETWORK=mainnet
