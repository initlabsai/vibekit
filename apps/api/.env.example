# Required — any OpenAI-compatible API (Together AI, Ollama, OpenAI, etc.)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama

# Optional — model identifier (default: gpt-4o)
LLM_MODEL=qwen3.5

# API keys — comma-separated label:key pairs for bearer token auth
API_KEYS=dev:sk_dev_test123

# Alpha Arcade API key — enables richer market data (images, categories, volume, rewards)
# ALPHA_ARCADE_API_KEY=

# Server port (default: 3001)
# PORT=3001

# CORS allowed origin (default: * — restrict in production)
# CORS_ORIGIN=https://explorer.vibekit.ai

# Algorand network: mainnet | testnet | localnet (default: mainnet)
# ALGORAND_NETWORK=mainnet

# Rate limiting (default: 10 requests per 60s window)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=10
