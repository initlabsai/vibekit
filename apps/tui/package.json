{
  "name": "@initlabs/vibekit-tui",
  "private": true,
  "version": "1.0.0-alpha.2",
  "description": "The VibeKit OpenTUI/React Explorer.",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.tsx",
    "build": "bun build src/index.tsx --outdir dist --target bun --external '@opentui/core-*'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist",
    "build:linux-x64": "bun build src/index.tsx --compile --target=bun-linux-x64 --outfile bin/vibekit-tui-linux-x64",
    "build:darwin-arm64": "bun build src/index.tsx --compile --target=bun-darwin-arm64 --outfile bin/vibekit-tui-darwin-arm64",
    "build:darwin-x64": "bun build src/index.tsx --compile --target=bun-darwin-x64 --outfile bin/vibekit-tui-darwin-x64",
    "build:win32-x64": "bun build src/index.tsx --compile --target=bun-windows-x64 --outfile bin/vibekit-tui-win32-x64.exe"
  },
  "dependencies": {
    "@initlabs/vibekit": "workspace:*",
    "@initlabs/vibekit-explorer": "workspace:*",
    "@opentui/core": "0.5.6",
    "@opentui/react": "0.5.6",
    "algosdk": "3.7.0",
    "react": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "ai": "^7.0.74",
    "typescript": "^5.9.3"
  }
}
